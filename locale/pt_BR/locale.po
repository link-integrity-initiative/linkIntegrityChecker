msgstr "Verificador de Integridade de Links"

msgid "plugins.generic.linkIntegrity.description"
msgstr "Audita os links e DOIs dos artigos publicados, apontando quebras e suas causas prováveis."

msgid "plugins.generic.linkIntegrity.subtitle"
msgstr "Monitoramento dos links e DOIs dos artigos publicados nesta revista."


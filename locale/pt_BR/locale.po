msgstr "QUEBRADO"

msgid "plugins.generic.linkIntegrity.statusAttention"
msgstr "ATENÇÃO"

msgid "plugins.generic.linkIntegrity.statusPending"
msgstr "Pendente"

msgid "plugins.generic.linkIntegrity.statusTesting"
